# Merilo — example environment file.
# Copy to `.env` locally. Never commit real values: `.env` is gitignored.

# Runtime mode: development | production.
# In production MERILO_HMAC_SECRET is mandatory (startup fails fast without it).
MERILO_ENV=

# SQLite path (defaults to backend/merilo.db when empty).
MERILO_DB_PATH=

# Uvicorn port used by the documented launch command (default 8000).
PORT=

# Gemini / LLM key. Leave empty to run the deterministic offline fallback.
GEMINI_API_KEY=

# Alternative name for GEMINI_API_KEY; used only when GEMINI_API_KEY is empty
# (kept for hosting platforms that inject the key under a generic name).
LLM_API_KEY=

# Gemini model id (default: gemini-3.6-flash; fallbacks: gemini-3.5-flash, gemini-3.5-flash-lite).
GEMINI_MODEL=

# HMAC-SHA256 key for card signatures and session tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Rotating it invalidates signatures of previously issued cards.
MERILO_HMAC_SECRET=

# Demo candidate password. If empty, a random password is generated on first
# seeding and printed once to the server console (never written to logs).
MERILO_DEMO_PASSWORD=

# Recruiter workspace (/app): OpenAI for Copilot, query parsing, challenge drafts.
OPENAI_API_KEY=
# One model for every AI task (Copilot, query parsing, Repo-to-Reality, Gate 3). Default: gpt-6-luna
OPENAI_MODEL=
# Daily token cap per server process (cost guard). Default 400000.
OPENAI_DAILY_TOKEN_BUDGET=
# Optional: require X-Merilo-Token on workspace API calls.
MERILO_API_TOKEN=
# Optional GitHub token for GitHub Intelligence (60 → 5000 requests/hour).
GITHUB_TOKEN=

# Verify-endpoint sliding-window rate limit (defaults: 20 requests / 60 seconds per IP).
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
